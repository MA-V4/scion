# GATEWAY
SCION_ENV=development
SCION_LOG_LEVEL=INFO
SCION_HOST=0.0.0.0
SCION_PORT=8000
SCION_SECRET_KEY=change-me-in-production

# DATABASE
DATABASE_URL=postgresql+asyncpg://scion:scion@localhost:5432/scion

# REDIS
REDIS_URL=redis://localhost:6379/0

# MODEL BACKENDS
GROQ_API_KEY=your-groq-api-key-here
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=http://localhost:8080

# OBSERVABILITY
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=scion-gateway
PROMETHEUS_PORT=9090

# EVALUATION
EVAL_BASELINE_PATH=benchmarks/results/baseline.json
EVAL_TASK_SUCCESS_THRESHOLD=0.85
EVAL_TOOL_ERROR_THRESHOLD=0.05
EVAL_LATENCY_P95_THRESHOLD=5.0

# GITHUB TOOL (optional)
GITHUB_TOKEN=your-github-token-here
GITHUB_DEFAULT_OWNER=MA-V4

# SEARCH TOOL (optional)
BRAVE_SEARCH_API_KEY=your-brave-api-key-here
